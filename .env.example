# Copy this file to .env and fill in any values you need.
# .env is gitignored — never commit real keys.

# --- Server ---
# Port the Express API listens on. Defaults to 3001 if unset.
PORT=3001

# Path to the SQLite database file. Defaults to ./data.db if unset.
# (The file is created on first run, gitignored.)
DATABASE_FILE=./data.db

# CORS origin for the Express API. Vite dev server runs on 5173 by default.
CORS_ORIGIN=http://localhost:5173

# --- Optional: third-party API keys ---
# Some students will plug their app into outside services. Add the key here,
# read it via process.env.SERVICE_API_KEY in apps/server/src, and never commit
# this file. Examples:
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# REPLICATE_API_TOKEN=r8_...
# OPENWEATHER_API_KEY=...
