{
  "name": "bhs-hackathon",
  "version": "0.1.0",
  "private": true,
  "description": "Barcelona High School AI Builder Hackathon — starter repo. Each student forks their own branch and ships a working web app in 24 hours.",
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "onboard": "node scripts/onboard.mjs",
    "dev": "npm-run-all --parallel dev:server dev:client",
    "dev:client": "npm --workspace apps/client run dev",
    "dev:server": "npm --workspace apps/server run dev",
    "groller": "npm --prefix g-roller run dev",
    "groller:build": "npm --prefix g-roller run build",
    "build": "npm-run-all build:server build:client",
    "build:client": "npm --workspace apps/client run build",
    "build:server": "npm --workspace apps/server run build",
    "typecheck": "npm-run-all typecheck:server typecheck:client",
    "typecheck:client": "npm --workspace apps/client run typecheck",
    "typecheck:server": "npm --workspace apps/server run typecheck",
    "test": "npm-run-all test:server test:client",
    "test:client": "npm --workspace apps/client run test",
    "test:server": "npm --workspace apps/server run test",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.6",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
