{
  "name": "@bhs/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Express + better-sqlite3 backend for the BHS hackathon starter.",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
